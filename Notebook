import sqlite3
import pandas as pd

# 1. Read Excel File
df = pd.read_excel("DataPenjualanFashion.xlsx")

# Clean column names (replace spaces/special characters with underscores)
df.columns = df.columns.str.strip().str.replace(" ", "_").str.lower()

# 2. Initialize SQLite Database Connection
conn = sqlite3.connect("fashion_sales.db")

# 3. Load DataFrame into SQL Table
df.to_sql("sales", conn, if_exists="replace", index=False)


# Helper function to run SQL queries and return DataFrames
def run_query(query):
  return pd.read_sql_query(query, conn)
